SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
SLACK_SCOPES=channels:history,channels:read,groups:history,groups:read,team:read,users:read
SLACK_SYNC_CHANNEL_LIMIT=10
SLACK_SYNC_MESSAGE_LIMIT=50

